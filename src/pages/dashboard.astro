---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import LocationForm from "@/components/profile/LocationForm";
import { createClient } from "@/lib/supabase";
import { getUserLocation } from "@/lib/profile";

const { user } = Astro.locals;

const supabase = createClient(Astro.request.headers, Astro.cookies);
const location = supabase && user ? await getUserLocation(supabase, user.id) : null;
---

<Layout title="Dashboard">
  <div class="bg-cosmic min-h-screen p-4">
    <div class="mx-auto max-w-2xl space-y-6">
      <Topbar />

      <div class="rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
        <h1 class="mb-4 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
          Dashboard
        </h1>
        <p class="text-blue-100/80" data-testid="dashboard-welcome">
          Welcome, <span class="font-semibold text-white">{user?.email}</span>
        </p>
        <p class="mt-2 text-sm text-blue-100/50">This page is only for authenticated users.</p>
      </div>

      <div class="rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-white">
        <h2 class="mb-2 text-xs font-medium tracking-wide text-blue-100/60 uppercase">Your location</h2>
        <LocationForm initialLocation={location} client:load />
      </div>
    </div>
  </div>
</Layout>
