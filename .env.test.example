# Copy to .env.test and fill in real values.
# Used by playwright.config.ts and the e2e/ test suite (local Supabase only — see
# `npx supabase start` in CLAUDE.md's Commands section).

# Base URL the e2e suite drives. Defaults to the Astro dev server's default port
# if unset; override only if you run the app on a different port.
E2E_BASE_URL=http://localhost:4321

# Pre-seeded test account used by e2e/auth.setup.ts to establish a reusable
# authenticated session (via storageState). Provisioned automatically by
# e2e/global-setup.ts if it doesn't already exist.
E2E_USERNAME=e2e-test@example.com
E2E_PASSWORD=change-me-e2e-test-password

# Local Supabase instance (from `npx supabase start` output).
SUPABASE_URL=http://127.0.0.1:54321
# Anon/public key — same value used by the app itself (see .env.example).
SUPABASE_KEY=###
# Service-role key — admin access, used only by e2e/global-setup.ts to
# provision the pre-seeded test user. Never used by the app itself.
SUPABASE_SERVICE_ROLE_KEY=###
